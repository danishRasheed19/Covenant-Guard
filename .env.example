# Copy to .env and fill in. Never commit .env.

# Required by SEC: identify yourself (name + email)
SEC_USER_AGENT="Your Name your.email@example.com"

# LLM provider (used from Phase 2 onward)
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=

# Postgres + pgvector (matches docker-compose.yml defaults; change for real use)
DATABASE_URL=postgresql://covenantguard:covenantguard@localhost:5432/covenantguard
